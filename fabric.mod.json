{
  "schemaVersion": 1,
  "id": "no-hotbar-swap-anim",
  "version": "${version}",
  "name": "No Hotbar Swap Animation",
  "description": "Removes the item switch/equip animation that plays when you change hotbar slots, so switching items is instant.",
  "authors": [
    "you"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.nohotbaranim.NoHotbarAnimMod"
    ]
  },
  "mixins": [
    "no-hotbar-swap-anim.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
